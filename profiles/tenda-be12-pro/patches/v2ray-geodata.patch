+GEOIP_URL:=https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/$(META_RULES_REVISION)/geoip-lite.dat
+GEOSITE_URL:=https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/$(META_RULES_REVISION)/geosite.dat
